{
    "name": "laravel-modular-accounting-platform",
    "version": "1.0.0",
    "description": "Enterprise-grade multi-tenant accounting platform built with Laravel 12",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "preview": "vite preview",
        "lint": "eslint resources/js --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint resources/js --ext .js,.jsx,.ts,.tsx --fix",
        "format": "prettier --write resources/js/**/*.{js,jsx,ts,tsx,css,scss}",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "axios": "^1.6.0",
        "eslint": "^8.54.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "jsdom": "^23.0.0",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.32",
        "prettier": "^3.1.0",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0"
    },
    "dependencies": {
        "@apollo/client": "^3.8.8",
        "@chakra-ui/react": "^2.8.2",
        "@emotion/react": "^11.11.1",
        "@emotion/styled": "^11.11.0",
        "@headlessui/react": "^1.7.17",
        "@heroicons/react": "^2.0.18",
        "@inertiajs/react": "^1.0.14",
        "@rematch/core": "^2.2.0",
        "@rematch/loading": "^2.1.2",
        "@rematch/persist": "^2.1.2",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.10",
        "alova": "^3.0.0",
        "chart.js": "^4.5.0",
        "date-fns": "^2.30.0",
        "framer-motion": "^10.16.16",
        "graphql": "^16.8.1",
        "react": "^18.2.0",
        "react-chartjs-2": "^5.3.0",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^18.2.0",
        "react-grid-layout": "^1.5.2",
        "react-redux": "^9.0.4",
        "react-router-dom": "^6.20.1",
        "recharts": "^3.2.1",
        "socket.io-client": "^4.7.4",
        "laravel-echo": "^1.15.3"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
