{
    "name": "laravel-modular-accounting-platform",
    "version": "1.0.0",
    "description": "Enterprise-grade multi-tenant accounting platform built with Laravel 12",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "preview": "vite preview",
        "lint": "eslint resources/js --ext .js,.vue,.ts",
        "lint:fix": "eslint resources/js --ext .js,.vue,.ts --fix",
        "format": "prettier --write resources/js/**/*.{js,vue,ts,css,scss}",
        "type-check": "vue-tsc --noEmit",
        "pwa:generate": "pwa-asset-generator resources/images/logo.svg public/pwa --manifest public/manifest.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "@vitejs/plugin-vue": "^4.5.0",
        "@vue/eslint-config-prettier": "^8.0.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.4.0",
        "autoprefixer": "^10.4.16",
        "axios": "^1.6.0",
        "eslint": "^8.54.0",
        "eslint-plugin-vue": "^9.18.0",
        "jsdom": "^23.0.0",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.32",
        "prettier": "^3.1.0",
        "sass": "^1.69.0",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vitest": "^1.0.0",
        "vue": "^3.3.0",
        "vue-tsc": "^1.8.0"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.0",
        "@heroicons/vue": "^2.0.0",
        "@tailwindcss/forms": "^0.5.0",
        "@tailwindcss/typography": "^0.5.0",
        "@vueuse/core": "^10.5.0",
        "chart.js": "^4.4.0",
        "date-fns": "^2.30.0",
        "echarts": "^5.4.0",
        "laravel-echo": "^1.15.0",
        "pinia": "^2.1.0",
        "pusher-js": "^8.4.0",
        "vue-chartjs": "^5.2.0",
        "vue-echarts": "^6.6.0",
        "vue-router": "^4.2.0",
        "workbox-precaching": "^7.0.0",
        "workbox-routing": "^7.0.0",
        "workbox-strategies": "^7.0.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}

