APP_NAME="Laravel Modular Accounting Platform"
APP_ENV=local
APP_KEY=base64:n9YWtV++e5bL6s0a+pfT/c2lLynkvrf4qaHXSbqtrNg=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Landlord Database Configuration
DB_CONNECTION=landlord
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=accounting_landlord
DB_USERNAME=root
DB_PASSWORD=

# Shared Database Shards
DB_SHARED_SHARD_1_HOST=127.0.0.1
DB_SHARED_SHARD_1_PORT=3306
DB_SHARED_SHARD_1_DATABASE=accounting_shared_1
DB_SHARED_SHARD_1_USERNAME=root
DB_SHARED_SHARD_1_PASSWORD=

DB_SHARED_SHARD_2_HOST=127.0.0.1
DB_SHARED_SHARD_2_PORT=3306
DB_SHARED_SHARD_2_DATABASE=accounting_shared_2
DB_SHARED_SHARD_2_USERNAME=root
DB_SHARED_SHARD_2_PASSWORD=

DB_SHARED_SHARD_3_HOST=127.0.0.1
DB_SHARED_SHARD_3_PORT=3306
DB_SHARED_SHARD_3_DATABASE=accounting_shared_3
DB_SHARED_SHARD_3_USERNAME=root
DB_SHARED_SHARD_3_PASSWORD=

DB_SHARED_SHARD_4_HOST=127.0.0.1
DB_SHARED_SHARD_4_PORT=3306
DB_SHARED_SHARD_4_DATABASE=accounting_shared_4
DB_SHARED_SHARD_4_USERNAME=root
DB_SHARED_SHARD_4_PASSWORD=

# Regional Clusters (Optional)
DB_CLUSTER_US_EAST_HOST=127.0.0.1
DB_CLUSTER_US_EAST_PORT=3306
DB_CLUSTER_US_EAST_DATABASE=accounting_cluster_us_east
DB_CLUSTER_US_EAST_USERNAME=root
DB_CLUSTER_US_EAST_PASSWORD=

DB_CLUSTER_US_WEST_HOST=127.0.0.1
DB_CLUSTER_US_WEST_PORT=3306
DB_CLUSTER_US_WEST_DATABASE=accounting_cluster_us_west
DB_CLUSTER_US_WEST_USERNAME=root
DB_CLUSTER_US_WEST_PASSWORD=

DB_CLUSTER_EU_WEST_HOST=127.0.0.1
DB_CLUSTER_EU_WEST_PORT=3306
DB_CLUSTER_EU_WEST_DATABASE=accounting_cluster_eu_west
DB_CLUSTER_EU_WEST_USERNAME=root
DB_CLUSTER_EU_WEST_PASSWORD=

DB_CLUSTER_AP_SOUTHEAST_HOST=127.0.0.1
DB_CLUSTER_AP_SOUTHEAST_PORT=3306
DB_CLUSTER_AP_SOUTHEAST_DATABASE=accounting_cluster_ap_southeast
DB_CLUSTER_AP_SOUTHEAST_USERNAME=root
DB_CLUSTER_AP_SOUTHEAST_PASSWORD=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting Configuration
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Cache Configuration
CACHE_STORE=file
CACHE_PREFIX=accounting_platform

# Queue Configuration
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Configuration (for WebSocket broadcasting)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# API Integration Services
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Security Configuration
SECURITY_MONITORING_ENABLED=true
AUDIT_LOG_ENABLED=true
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_DURATION=3600

# Module Configuration
MODULES_ENABLED="Organization,Accounting,Inventory,Reporting,Integration,Security,Mobile"
MODULE_AUTO_DISCOVERY=true

# Performance Configuration
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600
REPORT_CACHE_ENABLED=true
REPORT_CACHE_TTL=1800

# File Storage Configuration
FILESYSTEM_DISK=local
MEDIA_DISK=public

# Telescope Configuration (Development)
TELESCOPE_ENABLED=false

# Horizon Configuration (Production)
HORIZON_ENABLED=false

# Scout Configuration (Search)
SCOUT_DRIVER=null
SCOUT_PREFIX=accounting_platform

# Backup Configuration
BACKUP_DISK=s3
BACKUP_NOTIFICATION_MAIL_TO=admin@example.com

# Multi-Tenant Configuration
TENANT_AUTO_PROMOTION=true
TENANT_PROMOTION_USER_THRESHOLD=1000
TENANT_PROMOTION_TRANSACTION_THRESHOLD=100000
TENANT_PROMOTION_STORAGE_THRESHOLD=10240

# PWA Configuration
PWA_ENABLED=true
PWA_OFFLINE_ENABLED=true
PWA_PUSH_NOTIFICATIONS_ENABLED=true

# Real-time Configuration
REALTIME_ENABLED=true
REALTIME_STOCK_UPDATES=true
REALTIME_FINANCIAL_UPDATES=true

# Reporting Configuration
REPORT_EXPORT_FORMATS="pdf,excel,csv,json"
REPORT_SCHEDULING_ENABLED=true
REPORT_EMAIL_ENABLED=true

# Currency Configuration
DEFAULT_CURRENCY=USD
MULTI_CURRENCY_ENABLED=true
EXCHANGE_RATE_PROVIDER=fixer

# Localization Configuration
SUPPORTED_LOCALES="en,es,fr,de,ar"
DEFAULT_TIMEZONE=UTC

# Development Configuration
DEBUGBAR_ENABLED=false
IDE_HELPER_ENABLED=false


OCTANE_SERVER=roadrunner
