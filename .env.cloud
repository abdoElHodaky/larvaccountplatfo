APP_NAME="Laravel Modular Accounting Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-app.laravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Laravel Cloud Database Configuration
DB_CONNECTION=mysql
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_DATABASE=${DB_DATABASE}
DB_USERNAME=${DB_USERNAME}
DB_PASSWORD=${DB_PASSWORD}

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

# Cache Configuration (Laravel Cloud Redis)
CACHE_STORE=redis
CACHE_PREFIX=accounting_platform

# Queue Configuration (Laravel Cloud)
QUEUE_CONNECTION=redis

# Redis Configuration (Laravel Cloud managed)
REDIS_CLIENT=predis
REDIS_HOST=${REDIS_HOST}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=${REDIS_PORT}
REDIS_DB=0

# Mail Configuration (Laravel Cloud)
MAIL_MAILER=smtp
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# File Storage (Laravel Cloud S3)
FILESYSTEM_DISK=s3
MEDIA_DISK=s3

# AWS Configuration (Laravel Cloud managed)
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}
AWS_BUCKET=${AWS_BUCKET}
AWS_USE_PATH_STYLE_ENDPOINT=false

# Broadcasting (Use Laravel Cloud WebSockets)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=${REVERB_APP_ID}
REVERB_APP_KEY=${REVERB_APP_KEY}
REVERB_APP_SECRET=${REVERB_APP_SECRET}
REVERB_HOST=${REVERB_HOST}
REVERB_PORT=${REVERB_PORT}
REVERB_SCHEME=https

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Security Configuration
SECURITY_MONITORING_ENABLED=true
AUDIT_LOG_ENABLED=true
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_DURATION=3600

# Simplified Module Configuration for Cloud
MODULES_ENABLED="Organization,Accounting,Reporting"
MODULE_AUTO_DISCOVERY=false

# Performance Configuration
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600
REPORT_CACHE_ENABLED=true
REPORT_CACHE_TTL=1800

# Telescope (Disabled in production)
TELESCOPE_ENABLED=false

# Horizon (Use Laravel Cloud queue management)
HORIZON_ENABLED=false

# Multi-Tenant Configuration (Simplified for Cloud)
TENANT_AUTO_PROMOTION=false
TENANT_PROMOTION_USER_THRESHOLD=500

# PWA Configuration (Minimal for Cloud)
PWA_ENABLED=false
PWA_OFFLINE_ENABLED=false
PWA_PUSH_NOTIFICATIONS_ENABLED=false

# Real-time Configuration (Basic)
REALTIME_ENABLED=true
REALTIME_STOCK_UPDATES=false
REALTIME_FINANCIAL_UPDATES=true

# Currency Configuration
DEFAULT_CURRENCY=USD
MULTI_CURRENCY_ENABLED=false

# Localization Configuration
SUPPORTED_LOCALES="en"
DEFAULT_TIMEZONE=UTC

# Feature Flags for Laravel Cloud Deployment
FEATURE_MULTI_REGION=false
FEATURE_DATABASE_SHARDING=false
FEATURE_ADVANCED_REPORTING=false
FEATURE_REAL_TIME_COLLABORATION=false
FEATURE_MOBILE_APP=false
FEATURE_OCTANE=false
FEATURE_HORIZON=false
