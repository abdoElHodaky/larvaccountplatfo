APP_NAME="Laravel Modular Accounting Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Simplified Database Configuration for Forge
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=forge
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

# Cache Configuration (Use Forge Redis)
CACHE_STORE=redis
CACHE_PREFIX=accounting_platform

# Queue Configuration (Use Forge Redis)
QUEUE_CONNECTION=redis

# Redis Configuration (Forge managed)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# Mail Configuration (Use Forge mail settings)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# File Storage (Use S3 for production)
FILESYSTEM_DISK=s3
MEDIA_DISK=s3

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Broadcasting (Simplified - use Pusher)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=us2

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Security Configuration
SECURITY_MONITORING_ENABLED=true
AUDIT_LOG_ENABLED=true
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_DURATION=3600

# Simplified Module Configuration
MODULES_ENABLED="Organization,Accounting,Reporting"
MODULE_AUTO_DISCOVERY=false

# Performance Configuration
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=3600
REPORT_CACHE_ENABLED=true
REPORT_CACHE_TTL=1800

# Telescope (Disabled in production)
TELESCOPE_ENABLED=false

# Horizon (Enabled for queue management)
HORIZON_ENABLED=true

# Multi-Tenant Configuration (Simplified)
TENANT_AUTO_PROMOTION=false
TENANT_PROMOTION_USER_THRESHOLD=1000

# PWA Configuration
PWA_ENABLED=true
PWA_OFFLINE_ENABLED=false
PWA_PUSH_NOTIFICATIONS_ENABLED=false

# Real-time Configuration (Simplified)
REALTIME_ENABLED=true
REALTIME_STOCK_UPDATES=false
REALTIME_FINANCIAL_UPDATES=true

# Currency Configuration
DEFAULT_CURRENCY=USD
MULTI_CURRENCY_ENABLED=false

# Localization Configuration
SUPPORTED_LOCALES="en"
DEFAULT_TIMEZONE=UTC

# Feature Flags for Cloud Deployment
FEATURE_MULTI_REGION=false
FEATURE_DATABASE_SHARDING=false
FEATURE_ADVANCED_REPORTING=false
FEATURE_REAL_TIME_COLLABORATION=false
FEATURE_MOBILE_APP=false
